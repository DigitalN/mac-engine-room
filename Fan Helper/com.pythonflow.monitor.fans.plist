<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The fan helper's launchd job, registered by the app with SMAppService. launchd starts the
     helper as root on the first connection to the socket. scripts/build.sh copies this into
     Contents/Library/LaunchDaemons. The app looks for "<its bundle identifier>.fans.plist", so a
     test copy with its own identifier has no fan control until it gets its own (see Testing fan
     control in docs/DEVELOPMENT.md). -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.pythonflow.monitor.fans</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/Mac Engine Room Fans</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.pythonflow.monitor</string>
	</array>
	<key>Sockets</key>
	<dict>
		<key>Listener</key>
		<dict>
			<key>SockPathName</key>
			<string>/var/run/com.pythonflow.monitor.fans.sock</string>
			<key>SockPathMode</key>
			<integer>438</integer>
		</dict>
	</dict>
</dict>
</plist>
